APP_NAME=Orbital
APP_ENV=local
APP_URL=http://localhost:8058

# Server Configuration
PORT=8058
HOST=0.0.0.0

# Redis Configuration (for BullMQ queue)
REDIS_URL=redis://localhost:6379

# Database (SQLite)
DB_DATABASE=database/database.sqlite

# API Keys (comma-separated bootstrap keys for initial setup only)
# The admin panel can create, rotate, revoke, and delete keys after startup.
# API clients should send the raw key in the X-API-Key header.
API_KEYS=your-secret-api-key-change-me

# Admin web login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-session-secret

# Storage Paths (optional - defaults are fine for most setups)
# STORAGE_PATH=storage/app/artifacts

# Optional: point Playwright to a system-installed Chromium (useful in Docker)
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser
